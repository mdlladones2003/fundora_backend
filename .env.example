DATABASE_URL=postgres://fundora:fundora_dev_password@localhost:5432/fundora_db
PORT=8080
FRONTEND_ORIGIN=http://localhost:5173
# Use a public HTTPS frontend origin to enable Xendit checkout return redirects.
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=fundora
OTP_PEPPER=replace-with-a-long-random-secret
EMAIL_FROM="Fundora <onboarding@resend.dev>"
RESEND_API_KEY=re_your_resend_api_key
# Resend's test sender only delivers to authorized recipients. Verify a sender domain for general delivery.
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=
# Set these to the exact public frontend origin and chain to enable MetaMask sign-in.
SIWE_DOMAIN=
SIWE_URI=
SIWE_CHAIN_ID=
EVM_RPC_URL=
EVM_CHAIN_ID=11155111
EVM_DONATION_CONTRACT=
EVM_MIN_CONFIRMATIONS=2
# Debug builds default to a local payment simulator. For Xendit sandbox:
# PAYMENT_MODE=xendit
# XENDIT_SECRET_KEY=xnd_development_your_key
# XENDIT_WEBHOOK_TOKEN=your_webhook_callback_token
# Configure the Xendit payment_session.completed and payment_session.expired
# webhooks to POST to https://your-api.example/api/v1/webhooks/xendit.
PAYMENT_MODE=mock
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=
RUST_LOG=info
